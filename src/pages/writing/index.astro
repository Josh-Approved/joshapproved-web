---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<Base
  title="Writing · Josh Approved"
  description="Plain-language pieces on the common patterns in consumer software (tracking, ads, accounts, paywalls) and why I build the opposite kind."
>
  <div class="container">
    <header class="head">
      <h1>Writing</h1>
      <p class="lede">
        Most of these apps are a reaction to a handful of patterns I kept seeing
        in consumer software. These are those patterns, explained in plain terms,
        with a real attempt to be fair to the other side, and an honest account
        of where I think they stop serving you.
      </p>
    </header>

    <ul class="list">
      {posts.map((post) => (
        <li class="item">
          <a href={`/writing/${post.id}/`}>
            <h2>{post.data.title}</h2>
            <p>{post.data.dek}</p>
            <span class="more">Read</span>
          </a>
        </li>
      ))}
    </ul>

    <Footer />
  </div>
</Base>

<style>
  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .head {
    padding: 64px 0 8px;
  }
  .head h1 {
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 0 0 16px;
  }
  .head .lede {
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0;
  }
  .list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .item {
    border-bottom: 1px solid var(--hairline);
  }
  .item a {
    display: block;
    padding: 28px 0;
    text-decoration: none;
    color: inherit;
  }
  .item h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 8px;
  }
  .item p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0 0 12px;
  }
  .item .more {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marketing-terracotta);
  }
  .item a:hover h2 {
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 3px;
  }
  @media (max-width: 540px) {
    .container { padding: 0 20px; }
    .head h1 { font-size: 36px; }
    .head { padding: 40px 0 4px; }
  }
</style>
