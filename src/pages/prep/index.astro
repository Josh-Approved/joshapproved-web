---
/**
 * /prep/ — temporary, unlisted, passphrase-locked page.
 *
 * Nothing links here. It is not in the sitemap or llms.txt (both are generated
 * from the app data and the content collections), it carries noindex, and
 * robots.txt asks the AI crawlers to skip it.
 *
 * Unlike the portfolio gate, the content is genuinely ENCRYPTED: this repo and
 * the built site are public, so a curtain would not be enough. The page ships
 * ciphertext and decrypts in the browser once the passphrase is entered. The
 * passphrase itself is nowhere in the repo, and neither is the plaintext.
 *
 * Delete src/pages/prep/, src/data/prep-payload.json and
 * scripts/gen-prep-payload.mjs together when this is no longer needed.
 */
import Base from '../../layouts/Base.astro';
import payload from '../../data/prep-payload.json';
---

<Base title="Prep" description="Private notes." noindex>
  <main>
    <section class="gate" data-gate>
      <span class="icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      </span>
      <h1>Locked</h1>

      <form class="form" data-gate-form novalidate>
        <label class="field">
          <span class="fieldlabel">Password</span>
          <input
            type="password"
            name="prep-password"
            data-gate-input
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            aria-describedby="gate-error"
          />
        </label>
        <button type="submit">Unlock</button>
      </form>

      <p class="error" id="gate-error" data-gate-error role="status" hidden></p>
    </section>

    <div data-prep-content></div>
  </main>
</Base>

<script is:inline define:vars={{ payload }}>
  (function () {
    var STORE = 'ja-prep';
    var gate = document.querySelector('[data-gate]');
    var form = gate.querySelector('[data-gate-form]');
    var input = gate.querySelector('[data-gate-input]');
    var error = gate.querySelector('[data-gate-error]');
    var target = document.querySelector('[data-prep-content]');

    function bytes(b64) {
      var raw = atob(b64);
      var out = new Uint8Array(raw.length);
      for (var i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
      return out;
    }

    async function decrypt(password) {
      var base = await crypto.subtle.importKey(
        'raw',
        new TextEncoder().encode(password),
        'PBKDF2',
        false,
        ['deriveKey'],
      );
      var key = await crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt: bytes(payload.salt),
          iterations: payload.iterations,
          hash: 'SHA-256',
        },
        base,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt'],
      );
      // Wrong passphrase fails the GCM tag check and throws. That is the check.
      var plain = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: bytes(payload.iv) },
        key,
        bytes(payload.ct),
      );
      return new TextDecoder().decode(plain);
    }

    function reveal(html) {
      // Injected <style> still applies; the fragment scopes itself under #prep.
      target.innerHTML = html;
      gate.remove();
      // The fragment carries its own jump links, so honour a hash on load.
      if (location.hash) {
        var anchor = document.querySelector(location.hash);
        if (anchor) anchor.scrollIntoView();
      }
    }

    function fail(message) {
      error.textContent = message;
      error.hidden = false;
      gate.setAttribute('data-shake', '');
      setTimeout(function () {
        gate.removeAttribute('data-shake');
      }, 400);
      input.select();
    }

    // Unlocked once, stays unlocked on this device: the page is meant to be
    // glanced at repeatedly through a day, not re-unlocked every time.
    var saved = null;
    try {
      saved = window.localStorage.getItem(STORE);
    } catch (e) {
      /* storage blocked: the form still works for this page view */
    }
    if (saved) {
      decrypt(saved)
        .then(reveal)
        .catch(function () {
          try {
            window.localStorage.removeItem(STORE);
          } catch (e) {}
        });
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      error.hidden = true;

      if (!window.crypto || !crypto.subtle) {
        fail('This browser cannot unlock the page. Try a different one.');
        return;
      }

      var value = String(input.value).trim();
      if (!value) {
        fail('Enter the password first.');
        return;
      }

      var button = form.querySelector('button');
      button.disabled = true;
      button.textContent = 'Unlocking';

      try {
        var html = await decrypt(value);
        try {
          window.localStorage.setItem(STORE, value);
        } catch (e) {
          /* unlocked for this page view only */
        }
        input.value = '';
        reveal(html);
      } catch (e) {
        button.disabled = false;
        button.textContent = 'Unlock';
        fail('That password does not match.');
      }
    });
  })();
</script>

<style>
  /* The decrypted fragment sets its own width and padding, so the shell here
     only has to place the gate. */
  .gate {
    max-width: 620px;
    margin: 48px auto;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    padding: 40px;
    text-align: center;
  }
  .icon {
    display: inline-flex;
    color: var(--fg-muted);
    margin-bottom: 12px;
  }
  .gate h1 {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .form {
    margin-top: 18px;
    display: flex;
    gap: 10px;
    align-items: flex-end;
    justify-content: center;
    flex-wrap: wrap;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }
  .fieldlabel {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }
  .field input {
    box-sizing: border-box;
    font-family: var(--font-system);
    font-size: 16px;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-md);
    padding: 11px 14px;
    width: 260px;
    max-width: 100%;
  }
  .form button {
    font-family: var(--font-system);
    font-size: 15px;
    font-weight: var(--weight-medium);
    color: var(--fg-on-ink);
    background: var(--fg);
    border: 1px solid var(--fg);
    border-radius: var(--radius-md);
    padding: 12px 20px;
    cursor: pointer;
  }
  .form button[disabled] {
    opacity: 0.6;
    cursor: default;
  }

  .error {
    font-size: 14px;
    color: var(--danger);
    margin: 12px 0 0;
  }
  .gate[data-shake] {
    animation: shake 320ms cubic-bezier(0.2, 0, 0, 1);
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gate[data-shake] { animation: none; }
  }

  @media (max-width: 540px) {
    .gate { padding: 28px 20px; margin: 24px auto; }
    .form { flex-direction: column; align-items: stretch; }
    .field input { width: 100%; }
  }
</style>
