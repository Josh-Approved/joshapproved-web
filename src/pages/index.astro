---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppCard from '../components/AppCard.astro';
import { APPS } from '../data/apps.ts';

const shipped = APPS.filter((a) => a.status === 'shipped');
const inProgress = APPS.filter((a) => a.status === 'in-progress').length;
---
<Base title="Josh Approved — privacy-first replacements for paywalled utility apps">
  <div class="container">
    <Nav variant="full" />

    <section class="hero">
      <h1>Privacy-first replacements for paywalled utility apps.</h1>
      <p class="lede">
        Open source. Pay what you want. Every Josh Approved app does one thing,
        runs entirely on your device, and never asks for an account.
      </p>
      <div class="pillline">
        <span class="pill"><span class="dot"></span>No telemetry</span>
        <span class="pill"><span class="dot"></span>No accounts</span>
        <span class="pill"><span class="dot"></span>No ads</span>
        <span class="pill"><span class="dot"></span>MIT licensed</span>
      </div>
    </section>

    <div id="apps" class="section-head">
      <h2>Apps</h2>
      <span class="meta">
        {shipped.length} SHIPPED{inProgress > 0 ? ` · ${inProgress} IN PROGRESS` : ''}
      </span>
    </div>

    <div class="grid">
      {shipped.map((app) => <AppCard app={app} />)}
    </div>

    <section class="principles">
      <div class="principle">
        <span class="num">01</span>
        <h3>Your data stays with you</h3>
        <p>Apps run on your device. We never collect, store, or transmit your data.</p>
      </div>
      <div class="principle">
        <span class="num">02</span>
        <h3>Free, by default</h3>
        <p>No "pro" tier. No paywalls in front of features. No ads. You can pay if you want — or don't.</p>
      </div>
      <div class="principle">
        <span class="num">03</span>
        <h3>Radical transparency</h3>
        <p>Every app is open source. No hidden telemetry. Read the code or build it yourself.</p>
      </div>
    </section>

    <Footer />
  </div>
</Base>

<style>
  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .hero {
    padding: 80px 0 60px;
    max-width: 760px;
  }
  .hero h1 {
    font-size: 56px;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 0 0 18px;
  }
  .hero .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--fg-muted);
    max-width: 600px;
    margin: 0 0 22px;
  }
  .pillline {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-muted);
    background: var(--pure-white);
  }
  .pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 32px 0 16px;
    border-top: 1px solid var(--hairline);
  }
  .section-head h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }
  .section-head .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
  }
  .principles {
    padding: 40px 0 24px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    border-top: 1px solid var(--hairline);
    margin-top: 40px;
  }
  .principle h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 8px;
  }
  .principle p {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.55;
    margin: 0;
  }
  .principle .num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-subtle);
    margin-bottom: 8px;
    display: block;
    letter-spacing: 0.04em;
  }
  @media (max-width: 880px) {
    .hero {
      padding: 56px 0 40px;
    }
    .hero h1 {
      font-size: 40px;
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .principles {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
  @media (max-width: 540px) {
    .container {
      padding: 0 20px;
    }
    .hero h1 {
      font-size: 32px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
