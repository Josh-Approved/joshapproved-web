---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppCard from '../components/AppCard.astro';
import { APPS } from '../data/apps.ts';

const visible = APPS.filter((a) => a.status === 'shipped' || a.status === 'in-progress');
const shippedCount = APPS.filter((a) => a.status === 'shipped').length;
const inProgressCount = APPS.filter((a) => a.status === 'in-progress').length;
---
<Base
  title="Josh Approved — utility apps that do one thing and leave you alone"
  description="Utility apps that do one thing and leave you alone. No paywall, no ads, no tracking, no accounts — your data stays with you. Made by one person."
>
  <div class="brandrule"></div>
  <div class="container">
    <Nav variant="full" />

    <section class="hero">
      <h1>I build utility apps that do one thing and leave you alone.</h1>
      <p class="lede">
        After years building consumer apps, I got tired of simple tools wrapped in
        an account, a tracker, and a paywall in front of the one feature you opened
        the app for. So I make the opposite kind — customer-first, your data stays
        with you, no growth tricks. I'm Josh. This is everything I've made.
      </p>
      <div class="pillline">
        <span class="pill"><span class="dot"></span>No tracking</span>
        <span class="pill"><span class="dot"></span>Your data stays with you</span>
        <span class="pill"><span class="dot"></span>No ads</span>
        <span class="pill"><span class="dot"></span>Radical transparency</span>
      </div>
    </section>

    <div id="apps" class="section-head">
      <h2>Apps</h2>
      <span class="meta">
        {shippedCount} SHIPPED{inProgressCount > 0 ? ` · ${inProgressCount} IN BETA` : ''}
      </span>
    </div>

    <div class="grid">
      {visible.map((app) => <AppCard app={app} />)}
    </div>

    <section class="principles">
      <div class="principle">
        <span class="num">01</span>
        <h3>Your data stays with you</h3>
        <p>No tracking, no accounts, no analytics — and for the apps that need to sync, only ciphertext I can't read passes between your phones. There's nothing of yours for me to lose, sell, or hand over.</p>
      </div>
      <div class="principle">
        <span class="num">02</span>
        <h3>Pay what you want</h3>
        <p>No paywall. The whole app is the whole app. Josh Approved is supported by the people who use it — if these apps are useful to you, consider donating. That's what keeps the work going.</p>
      </div>
      <div class="principle">
        <span class="num">03</span>
        <h3>Radical transparency</h3>
        <p>Every app is open source. You don't have to take my word for any of this — read the code on GitHub, or build it yourself.</p>
      </div>
    </section>

    <Footer />
  </div>
</Base>

<style>
  .brandrule {
    height: 3px;
    background: var(--marketing-terracotta);
  }
  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .hero {
    padding: 80px 0 60px;
    max-width: 760px;
  }
  .hero h1 {
    font-size: 56px;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 0 0 18px;
  }
  .hero .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--fg-muted);
    max-width: 600px;
    margin: 0 0 22px;
  }
  .pillline {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-muted);
    background: var(--bg-elevated);
  }
  .pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 32px 0 16px;
    border-top: 1px solid var(--hairline);
  }
  .section-head h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }
  .section-head .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
  }
  .principles {
    padding: 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    background: var(--marketing-terracotta-bg);
    border-radius: 16px;
    margin-top: 48px;
  }
  .principle h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 8px;
  }
  .principle p {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.55;
    margin: 0;
  }
  .principle .num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-subtle);
    margin-bottom: 8px;
    display: block;
    letter-spacing: 0.04em;
  }
  @media (max-width: 880px) {
    .hero {
      padding: 56px 0 40px;
    }
    .hero h1 {
      font-size: 40px;
    }
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid > :global(:nth-child(odd):last-child) {
      grid-column: 1 / -1;
    }
    .principles {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
  @media (max-width: 540px) {
    .container {
      padding: 0 20px;
    }
    .hero h1 {
      font-size: 32px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
