---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AppIcon from '../../components/AppIcon.astro';
import { APPS, PLATFORM_LABEL, platformUrl } from '../../data/apps.ts';

export function getStaticPaths() {
  return APPS.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
---
<Base title={`${app.name} · Josh Approved`} description={app.tagline}>
  <div class="container">
    <Nav variant="crumb" crumb={app.name} />

    <section class="hero">
      <AppIcon app={app} size="lg" />
      <div>
        <div class="title-row">
          <h1>{app.name}</h1>
          {app.status === 'in-progress' && <span class="beta-tag">BETA</span>}
        </div>
        <p>{app.tagline}</p>
        {app.status === 'in-progress' && (
          <p class="beta-note">In TestFlight while I finish the last device-testing pass. Public listing soon — the GitHub source is open today.</p>
        )}
      </div>
    </section>

    <div class="cta-row">
      {app.appStoreUrl && (
        <a class="badge-link" href={app.appStoreUrl} rel="noopener" aria-label="Download on the App Store">
          <img src="/assets/badges/apple-app-store.svg" alt="Download on the App Store" width="132" height="44" />
        </a>
      )}
      {app.playStoreUrl && (
        <a class="badge-link" href={app.playStoreUrl} rel="noopener" aria-label="Get it on Google Play">
          <img src="/assets/badges/google-play.svg" alt="Get it on Google Play" width="149" height="44" />
        </a>
      )}
      {app.webStoreUrl && (
        <a class="btn primary" href={app.webStoreUrl} rel="noopener">
          Add to Chrome
        </a>
      )}
      <a class="btn secondary" href={app.github} rel="noopener">
        Source on GitHub
      </a>
    </div>

    <div class="specs">
      <div class="spec">
        <div class="lab">Platforms</div>
        <div class="val">
          {app.platforms.map((p, i) => {
            const label = PLATFORM_LABEL[p] ?? p;
            const url = platformUrl(p, app);
            return (
              <>
                {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                {url ? (
                  <a class="platform-link" href={url} rel="noopener">{label}</a>
                ) : (
                  <span>{label}</span>
                )}
              </>
            );
          })}
        </div>
      </div>
      <div class="spec">
        <div class="lab">Permissions</div>
        <div class="val">{app.permissions ?? 'None'}</div>
      </div>
      <div class="spec">
        <div class="lab">Network</div>
        <div class="val">{app.network ?? 'None'}</div>
      </div>
      <div class="spec">
        <div class="lab">License</div>
        <div class="val">{app.license ?? 'MIT'}</div>
      </div>
    </div>

    {app.body && (
      <section class="body">
        {app.body.map((para, i) => (
          <p class={i === 0 ? '' : 'dim'}>{para}</p>
        ))}

        {app.privacy && (
          <div class="privacy">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <div>
              <h3>{app.privacy.headline}</h3>
              <ul>
                {app.privacy.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        )}
      </section>
    )}

    <Footer />
  </div>
</Base>

<style>
  .container {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .hero {
    padding: 48px 0 32px;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 28px;
    align-items: center;
  }
  .hero .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 0 6px;
  }
  .hero h1 {
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .beta-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--marketing-terracotta);
    border: 1px solid var(--marketing-terracotta);
    border-radius: 4px;
    padding: 3px 7px;
    line-height: 1;
  }
  .hero p {
    font-size: 16px;
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.5;
  }
  .hero .beta-note {
    font-size: 14px;
    color: var(--marketing-terracotta);
    margin-top: 8px;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0 24px;
    flex-wrap: wrap;
  }
  .badge-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .badge-link img {
    height: 44px;
    width: auto;
    display: block;
  }
  .badge-link:hover {
    opacity: 0.82;
  }
  .btn {
    height: 44px;
    padding: 0 18px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .btn.primary {
    background: var(--ink-1000);
    color: var(--paper);
    border: 1px solid var(--ink-1000);
  }
  .btn.primary:hover {
    background: var(--ink-900);
  }
  .btn.secondary {
    background: var(--pure-white);
    color: var(--fg);
    border: 1px solid var(--hairline);
  }
  .btn.secondary:hover {
    border-color: var(--fg);
  }
  .specs {
    margin: 0 0 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
  }
  .spec {
    background: var(--paper);
    padding: 14px 18px;
  }
  .spec .lab {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .spec .val {
    font-size: 15px;
    font-weight: 500;
    color: var(--fg);
    margin-top: 4px;
  }
  .platform-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--marketing-terracotta);
    text-underline-offset: 3px;
    transition: color 120ms;
  }
  .platform-link:hover {
    color: var(--marketing-terracotta);
  }
  .body {
    padding: 24px 0;
  }
  .body p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 14px;
    max-width: 640px;
  }
  .body p.dim {
    color: var(--fg-muted);
  }
  .privacy {
    padding: 22px 24px;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--pure-white);
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 14px;
    margin: 16px 0 20px;
    max-width: 720px;
  }
  .privacy svg {
    color: var(--accent);
    margin-top: 2px;
  }
  .privacy h3 {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--fg);
  }
  .privacy ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }
  .privacy li {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .container {
      padding: 0 20px;
    }
    .hero {
      grid-template-columns: 72px 1fr;
      gap: 16px;
      padding: 32px 0 24px;
    }
    .hero :global(.frame--lg) {
      --icon-size: 72px;
      --icon-radius: 18px;
      --corner-size: 18px;
      --corner-offset: 6px;
      --corner-radius: 4px;
      --glyph-size: 28px;
      --ig-size: 18px;
      --ig-em-size: 13px;
    }
    .hero h1 {
      font-size: 26px;
    }
    .specs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
