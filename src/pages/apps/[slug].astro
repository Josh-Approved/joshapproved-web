---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AppIcon from '../../components/AppIcon.astro';
import { APPS, PLATFORM_LABEL, platformUrl } from '../../data/apps.ts';
import QRCode from 'qrcode';

export function getStaticPaths() {
  return APPS.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props;

const pageTitle = app.seoTitle
  ? `${app.name} — ${app.seoTitle} · Josh Approved`
  : `${app.name} · Josh Approved`;

// SoftwareApplication structured data — honest signal for search, no doorway
// content. Price 0 (pay-what-you-want); only emit an AggregateRating when real.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: app.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: app.platforms
    .map((p) => ({ ios: 'iOS', android: 'Android', mac: 'macOS', chrome: 'Chrome', firefox: 'Firefox' }[p] ?? p))
    .join(', '),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  url: `https://joshapproved.com/apps/${app.slug}/`,
  ...(app.keywords ? { keywords: app.keywords } : {}),
  ...(app.appStoreUrl || app.playStoreUrl || app.webStoreUrl
    ? { downloadUrl: app.appStoreUrl ?? app.playStoreUrl ?? app.webStoreUrl }
    : {}),
  author: { '@type': 'Organization', name: 'Josh Approved', url: 'https://joshapproved.com' },
};

// --- Smart install link (?install=1) ---------------------------------------
// The install link is this SAME canonical app URL plus ?install=1. Natural
// navigation (no param) is untouched. With the param, a tiny client script
// detects the device and hands off to the live store via its app URL scheme so
// this page stays in the browser tab. Store availability is read straight from
// the merged app data — a store URL is present ONLY when that store is live — so
// we never route anyone to a listing that isn't approved yet, and every new app
// gets a working link automatically the moment its store goes live.
const installUrl = `https://joshapproved.com/apps/${app.slug}?install=1`;

const iosHttps = app.appStoreUrl;        // present ⇒ App Store is live
const androidHttps = app.playStoreUrl;   // present ⇒ Google Play is live
const webHttps = app.webStoreUrl;        // present ⇒ browser extension is live

const iosId = iosHttps?.match(/id(\d+)/)?.[1] ?? null;
const androidPkg = androidHttps?.match(/[?&]id=([^&]+)/)?.[1] ?? null;
const iosScheme = iosId ? `itms-apps://itunes.apple.com/app/id${iosId}` : null;
const androidScheme = androidPkg ? `market://details?id=${androidPkg}` : null;

const hasMobileStore = Boolean(iosHttps || androidHttps);
const hasAnyStore = Boolean(iosHttps || androidHttps || webHttps);

// QR built once, at build time — only when a phone store is actually live.
// Scanning it on a phone re-runs the same detection → the right store.
let qrSvg = '';
if (hasMobileStore) {
  qrSvg = await QRCode.toString(installUrl, {
    type: 'svg',
    margin: 1,
    errorCorrectionLevel: 'M',
    color: { dark: '#1a1a1a', light: '#00000000' },
  });
}
---
<Base title={pageTitle} description={app.tagline}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* Smart-link handoff. Runs ONLY when the URL carries ?install=1, so every
      other way of reaching this page behaves exactly as before. */}
  <script define:vars={{ iosScheme, iosHttps, androidScheme, androidHttps }}>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (!params.has('install')) return;

      var ua = navigator.userAgent || '';
      var isIPhone = /iPhone|iPod/.test(ua);
      var isAndroidPhone = /Android/.test(ua) && /Mobile/.test(ua);

      // Open the store APP via its URL scheme so this page stays in the tab.
      // If the scheme doesn't fire (rare on real devices; some in-app
      // webviews), fall back to the https store URL — but only if we're still
      // visible (i.e. the store app did NOT take over).
      function handoff(scheme, https) {
        if (!scheme && !https) return;
        var fallback = setTimeout(function () {
          if (document.visibilityState === 'visible' && https) {
            window.location.href = https;
          }
        }, 1200);
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) clearTimeout(fallback);
        }, { once: true });
        window.location.href = scheme || https;
      }

      if (isIPhone) {
        // Hand off only if the App Store is live for this app; otherwise stay
        // on the page (it shows the real availability/BETA status).
        if (iosScheme || iosHttps) handoff(iosScheme, iosHttps);
        return;
      }
      if (isAndroidPhone) {
        if (androidScheme || androidHttps) handoff(androidScheme, androidHttps);
        return;
      }

      // Desktop / iPad / tablet / unknown → show the install modal if we built
      // one (we only build it when at least one store is live).
      function openModal() {
        var m = document.getElementById('install-modal');
        if (m) { m.hidden = false; document.documentElement.style.overflow = 'hidden'; }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', openModal);
      } else {
        openModal();
      }
    })();
  </script>

  <div class="container">
    <Nav variant="crumb" crumb={app.name} />

    <section class="hero">
      <AppIcon app={app} size="lg" />
      <div>
        <div class="title-row">
          <h1>{app.name}</h1>
          {app.status === 'in-progress' && <span class="beta-tag">BETA</span>}
        </div>
        <p>{app.tagline}</p>
        {app.status === 'in-progress' && (
          <p class="beta-note">In TestFlight while I finish the last device-testing pass. Public listing soon — the GitHub source is open today.</p>
        )}
      </div>
    </section>

    <div class="cta-row">
      {app.appStoreUrl && (
        <a class="badge-link" href={app.appStoreUrl} rel="noopener" aria-label="Download on the App Store">
          <img src="/assets/badges/apple-app-store.svg" alt="Download on the App Store" width="132" height="44" />
        </a>
      )}
      {app.playStoreUrl && (
        <a class="badge-link" href={app.playStoreUrl} rel="noopener" aria-label="Get it on Google Play">
          <img src="/assets/badges/google-play.svg" alt="Get it on Google Play" width="149" height="44" />
        </a>
      )}
      {app.webStoreUrl && (
        <a class="btn primary" href={app.webStoreUrl} rel="noopener">
          Add to Chrome
        </a>
      )}
      <a class="btn secondary" href={app.github} rel="noopener">
        Source on GitHub
      </a>
    </div>

    <div class="specs">
      <div class="spec">
        <div class="lab">Platforms</div>
        <div class="val">
          {app.platforms.map((p, i) => {
            const label = PLATFORM_LABEL[p] ?? p;
            const url = platformUrl(p, app);
            return (
              <>
                {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                {url ? (
                  <a class="platform-link" href={url} rel="noopener">{label}</a>
                ) : (
                  <span>{label}</span>
                )}
              </>
            );
          })}
        </div>
      </div>
      <div class="spec">
        <div class="lab">Permissions</div>
        <div class="val">{app.permissions ?? 'None'}</div>
      </div>
      <div class="spec">
        <div class="lab">Network</div>
        <div class="val">{app.network ?? 'None'}</div>
      </div>
      <div class="spec">
        <div class="lab">License</div>
        <div class="val">{app.license ?? 'MIT'}</div>
      </div>
    </div>

    {app.body && (
      <section class="body">
        {app.body.map((para, i) => (
          <p class={i === 0 ? '' : 'dim'}>{para}</p>
        ))}

        {app.privacy && (
          <div class="privacy">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <div>
              <h3>{app.privacy.headline}</h3>
              <ul>
                {app.privacy.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        )}
      </section>
    )}

    <Footer />
  </div>

  {hasAnyStore && (
    <div id="install-modal" class="install-modal" hidden>
      <div class="install-backdrop" data-close></div>
      <div class="install-card" role="dialog" aria-modal="true" aria-label={`Get ${app.name}`}>
        <button class="install-close" type="button" data-close aria-label="Close">&times;</button>
        <h2>Get {app.name}</h2>
        <p class="install-sub">Free. No paywall, no ads, no tracking.</p>
        {hasMobileStore && qrSvg && (
          <div class="install-qr">
            <Fragment set:html={qrSvg} />
            <span>Scan with your phone’s camera to install</span>
          </div>
        )}
        <div class="install-stores">
          {iosHttps && (
            <a class="badge-link" href={iosHttps} rel="noopener" aria-label="Download on the App Store">
              <img src="/assets/badges/apple-app-store.svg" alt="Download on the App Store" width="132" height="44" />
            </a>
          )}
          {androidHttps && (
            <a class="badge-link" href={androidHttps} rel="noopener" aria-label="Get it on Google Play">
              <img src="/assets/badges/google-play.svg" alt="Get it on Google Play" width="149" height="44" />
            </a>
          )}
          {webHttps && (
            <a class="btn primary" href={webHttps} rel="noopener">Add to your browser</a>
          )}
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var m = document.getElementById('install-modal');
        if (!m) return;
        function close() { m.hidden = true; document.documentElement.style.overflow = ''; }
        m.querySelectorAll('[data-close]').forEach(function (el) {
          el.addEventListener('click', close);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !m.hidden) close();
        });
      })();
    </script>
  )}
</Base>

<style>
  .container {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .hero {
    padding: 48px 0 32px;
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 28px;
    align-items: center;
  }
  .hero .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 0 6px;
  }
  .hero h1 {
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .beta-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--marketing-terracotta);
    border: 1px solid var(--marketing-terracotta);
    border-radius: 4px;
    padding: 3px 7px;
    line-height: 1;
  }
  .hero p {
    font-size: 16px;
    color: var(--fg-muted);
    margin: 0;
    line-height: 1.5;
  }
  .hero .beta-note {
    font-size: 14px;
    color: var(--marketing-terracotta);
    margin-top: 8px;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0 24px;
    flex-wrap: wrap;
  }
  .badge-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .badge-link img {
    height: 44px;
    width: auto;
    display: block;
  }
  .badge-link:hover {
    opacity: 0.82;
  }
  .btn {
    height: 44px;
    padding: 0 18px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .btn.primary {
    background: var(--ink-1000);
    color: var(--paper);
    border: 1px solid var(--ink-1000);
  }
  .btn.primary:hover {
    background: var(--ink-900);
  }
  .btn.secondary {
    background: var(--pure-white);
    color: var(--fg);
    border: 1px solid var(--hairline);
  }
  .btn.secondary:hover {
    border-color: var(--fg);
  }
  .specs {
    margin: 0 0 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
  }
  .spec {
    background: var(--paper);
    padding: 14px 18px;
  }
  .spec .lab {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .spec .val {
    font-size: 15px;
    font-weight: 500;
    color: var(--fg);
    margin-top: 4px;
  }
  .platform-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--marketing-terracotta);
    text-underline-offset: 3px;
    transition: color 120ms;
  }
  .platform-link:hover {
    color: var(--marketing-terracotta);
  }
  .body {
    padding: 24px 0;
  }
  .body p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 14px;
    max-width: 640px;
  }
  .body p.dim {
    color: var(--fg-muted);
  }
  .privacy {
    padding: 22px 24px;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--pure-white);
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 14px;
    margin: 16px 0 20px;
    max-width: 720px;
  }
  .privacy svg {
    color: var(--accent);
    margin-top: 2px;
  }
  .privacy h3 {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--fg);
  }
  .privacy ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }
  .privacy li {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .container {
      padding: 0 20px;
    }
    .hero {
      grid-template-columns: 72px 1fr;
      gap: 16px;
      padding: 32px 0 24px;
    }
    .hero :global(.frame--lg) {
      --icon-size: 72px;
      --icon-radius: 18px;
      --corner-size: 18px;
      --corner-offset: 6px;
      --corner-radius: 4px;
      --glyph-size: 28px;
      --ig-size: 18px;
      --ig-em-size: 13px;
    }
    .hero h1 {
      font-size: 26px;
    }
    .specs {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Install modal (desktop / low-confidence devices via ?install=1) */
  .install-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .install-modal[hidden] {
    display: none;
  }
  .install-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 20, 0.55);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  .install-card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 16px;
    padding: 32px;
    max-width: 360px;
    width: 100%;
    text-align: center;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
  }
  .install-card h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
  }
  .install-sub {
    font-size: 14px;
    color: var(--fg-muted);
    margin: 0 0 20px;
  }
  .install-close {
    position: absolute;
    top: 10px;
    right: 14px;
    background: none;
    border: none;
    font-size: 24px;
    line-height: 1;
    color: var(--fg-muted);
    cursor: pointer;
    padding: 4px;
  }
  .install-close:hover {
    color: var(--fg);
  }
  .install-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
  }
  .install-qr :global(svg) {
    width: 176px;
    height: 176px;
    display: block;
  }
  .install-qr span {
    font-size: 12px;
    color: var(--fg-muted);
  }
  .install-stores {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
</style>
