---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import AppIcon from '../../components/AppIcon.astro';
import MoreApps from '../../components/MoreApps.astro';
import { APPS, PLATFORM_LABEL, platformUrl } from '../../data/apps.ts';
import { FAQ, RELATED_ESSAYS } from '../../data/appContent.ts';
import { getCollection } from 'astro:content';
import QRCode from 'qrcode';

export function getStaticPaths() {
  return APPS.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props;

// The studio wedge, byte form, locked order (canonical-voice.md § The studio
// wedge). Rendered as chips so the differentiator is scannable above the fold.
const WEDGE = ['No paywall', 'No ads', 'No tracking', 'No accounts'];

// Page <title> for search/tab. The brand isn't appended; og:site_name carries
// it and the canonical domain (joshapproved.com) already shows it, so a "· Josh
// Approved" suffix only made share-card titles redundant and over-long.
const pageTitle = app.seoTitle
  ? `${app.name}: ${app.seoTitle}`
  : app.name;

// Share-card image (1200×630, generated by scripts/gen-og-images.mjs) + a short,
// brand-free card title so link previews read "Grocery List · joshapproved.com"
// instead of a stacked, repetitive line over a generic browser icon.
const ogImage = app.icon ? `/assets/og/${app.slug}.png` : undefined;

// SoftwareApplication structured data: honest signal for search, no doorway
// content. Price 0 (pay-what-you-want); only emit an AggregateRating when real.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: app.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: app.platforms
    .map((p) => ({ ios: 'iOS', android: 'Android', mac: 'macOS', chrome: 'Chrome', firefox: 'Firefox' }[p] ?? p))
    .join(', '),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  url: `https://joshapproved.com/apps/${app.slug}/`,
  ...(app.keywords ? { keywords: app.keywords } : {}),
  ...(app.appStoreUrl || app.playStoreUrl || app.webStoreUrl
    ? { downloadUrl: app.appStoreUrl ?? app.playStoreUrl ?? app.webStoreUrl }
    : {}),
  author: { '@type': 'Organization', '@id': 'https://joshapproved.com/#org', name: 'Josh Approved', url: 'https://joshapproved.com' },
  publisher: { '@id': 'https://joshapproved.com/#org' },
};

// Breadcrumb trail (mirrors the on-page crumb nav) so Google can render a
// Home › Apps › <App> breadcrumb in the search result instead of a raw URL.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://joshapproved.com/' },
    { '@type': 'ListItem', position: 2, name: 'Apps', item: 'https://joshapproved.com/apps/' },
    { '@type': 'ListItem', position: 3, name: app.name, item: `https://joshapproved.com/apps/${app.slug}/` },
  ],
};

// FAQ + cross-links. FAQ feeds a visible section and FAQPage structured data.
// Related essays (the "why") and related blog posts (launch / alternative pieces)
// connect this page into the rest of the site, better for readers and crawlers.
const faq = FAQ[app.slug] ?? [];
const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const essayIds = RELATED_ESSAYS[app.slug] ?? [];
const allWriting = await getCollection('writing');
const relatedEssays = essayIds
  .map((id) => allWriting.find((w) => w.id === id))
  .filter((w): w is NonNullable<typeof w> => Boolean(w));

const relatedPosts = (await getCollection('posts'))
  .filter((p) => !p.data.draft && p.data.app === app.slug)
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime());

// --- Smart install link (?install=1) ---------------------------------------
// The install link is this SAME canonical app URL plus ?install=1. Natural
// navigation (no param) is untouched. With the param, a tiny client script
// detects the device and hands off to the live store via its app URL scheme so
// this page stays in the browser tab. Store availability is read straight from
// the merged app data: a store URL is present ONLY when that store is live, so
// we never route anyone to a listing that isn't approved yet, and every new app
// gets a working link automatically the moment its store goes live.
const installUrl = `https://joshapproved.com/apps/${app.slug}?install=1`;

const iosHttps = app.appStoreUrl;        // present ⇒ App Store is live
const androidHttps = app.playStoreUrl;   // present ⇒ Google Play is live
const webHttps = app.webStoreUrl;        // present ⇒ browser extension is live

const iosId = iosHttps?.match(/id(\d+)/)?.[1] ?? null;
const androidPkg = androidHttps?.match(/[?&]id=([^&]+)/)?.[1] ?? null;
const iosScheme = iosId ? `itms-apps://itunes.apple.com/app/id${iosId}` : null;
const androidScheme = androidPkg ? `market://details?id=${androidPkg}` : null;

const hasMobileStore = Boolean(iosHttps || androidHttps);
const hasAnyStore = Boolean(iosHttps || androidHttps || webHttps);

// QR built once, at build time, only when a phone store is actually live.
// Scanning it on a phone re-runs the same detection → the right store.
let qrSvg = '';
if (hasMobileStore) {
  qrSvg = await QRCode.toString(installUrl, {
    type: 'svg',
    margin: 1,
    errorCorrectionLevel: 'M',
    color: { dark: '#1a1a1a', light: '#00000000' },
  });
}
---
<Base title={pageTitle} description={app.tagline} ogTitle={app.name} image={ogImage} crumb={app.name}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

  {/* Smart-link handoff. Runs ONLY when the URL carries ?install=1, so every
      other way of reaching this page behaves exactly as before. */}
  <script define:vars={{ iosScheme, androidScheme }}>
    (function () {
      var params = new URLSearchParams(window.location.search);
      if (!params.has('install')) return;

      var ua = navigator.userAgent || '';
      var isIPhone = /iPhone|iPod/.test(ua);
      var isAndroidPhone = /Android/.test(ua) && /Mobile/.test(ua);
      // In-app browsers (Instagram / Facebook / TikTok / etc.) suppress
      // app-scheme launches, so there the auto-handoff genuinely can't fire, and we
      // show a device-aware install card instead of a dead scheme navigation.
      var isInAppWebview = /(FBAN|FBAV|FB_IAB|Instagram|Line\/|Twitter|TikTok|musical_ly|Snapchat|Pinterest|; ?wv\b)/i.test(ua);

      // Do store work ONLY after the full app page has loaded and painted, so
      // the real page is the visible document the whole time. This ordering is
      // the fix for the blank tab: a top-frame scheme navigation fired before
      // paint aborts the in-progress render; fired after paint it shows the
      // "Open in the App Store?" prompt over the rendered page, and Cancel
      // returns the visitor to that page.
      function afterPaint(run) {
        function go() {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { setTimeout(run, 350); });
          });
        }
        if (document.readyState === 'complete') go();
        else window.addEventListener('load', go, { once: true });
      }

      // Reveal the install card limited to ONE platform's store, never offer
      // Google Play to an iPhone or vice-versa. No QR (we're already on a phone).
      function revealCard(platform) {
        var m = document.getElementById('install-modal');
        if (!m) return;
        m.querySelectorAll('[data-store]').forEach(function (el) {
          el.style.display = el.getAttribute('data-store') === platform ? '' : 'none';
        });
        var qr = m.querySelector('.install-qr');
        if (qr) qr.style.display = 'none';
        m.hidden = false;
        document.documentElement.style.overflow = 'hidden';
      }

      if (isIPhone) {
        if (!iosScheme) return; // App Store not live for this app → stay on page
        if (isInAppWebview) { afterPaint(function () { revealCard('ios'); }); return; }
        // Normal iOS Safari: a top-frame navigation to the App Store scheme,
        // fired after paint, reliably opens the "Open in the App Store?" prompt
        // over the rendered page without replacing it (custom schemes don't
        // unload the document). This is the only reliable auto-launch on current
        // iOS. The hidden-iframe trick is suppressed by Safari.
        afterPaint(function () { window.location.href = iosScheme; });
        return;
      }
      if (isAndroidPhone) {
        if (!androidScheme) return;
        if (isInAppWebview) { afterPaint(function () { revealCard('android'); }); return; }
        afterPaint(function () { window.location.href = androidScheme; });
        return;
      }

      // Desktop / iPad / tablet / unknown → full install modal (all live stores
      // + QR) if we built one (only built when at least one store is live).
      function openModal() {
        var m = document.getElementById('install-modal');
        if (m) { m.hidden = false; document.documentElement.style.overflow = 'hidden'; }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', openModal);
      } else {
        openModal();
      }
    })();
  </script>

  <div class="container">
    <section class={`lede${app.demo ? ' lede--demo' : ''}`}>
      <div class="lede-copy">
        <div class="idrow">
          <AppIcon app={app} size="lg" />
          <div class="title-row">
            <h1>{app.name}</h1>
            {app.status === 'in-progress' && <span class="beta-tag">BETA</span>}
          </div>
        </div>

        <p class="value">{app.value ?? app.description}</p>

        <ul class="wedge" aria-label="What this costs you">
          {WEDGE.map((claim) => <li>{claim}</li>)}
        </ul>
        <p class="signature">Your data stays with you.</p>

        {app.status === 'in-progress' && (
          <p class="beta-note">In TestFlight while I finish the last device-testing pass. Public listing soon. The GitHub source is open today.</p>
        )}

        <div class="cta-row">
          {app.appStoreUrl && (
            <a class="badge-link" href={app.appStoreUrl} rel="noopener" aria-label="Download on the App Store">
              <img src="/assets/badges/apple-app-store.svg" alt="Download on the App Store" width="132" height="44" />
            </a>
          )}
          {app.playStoreUrl && (
            <a class="badge-link" href={app.playStoreUrl} rel="noopener" aria-label="Get it on Google Play">
              <img src="/assets/badges/google-play.svg" alt="Get it on Google Play" width="149" height="44" />
            </a>
          )}
          {app.webStoreUrl && (
            <a class="btn primary" href={app.webStoreUrl} rel="noopener">
              Add to Chrome
            </a>
          )}
          <a class="btn secondary" href={app.github} rel="noopener">
            Source on GitHub
          </a>
        </div>
      </div>

      {app.demo && (
        <div class="lede-demo">
          {/* Plain <picture>: the <img> loads the .gif, which animates on its own
              the moment motion is allowed, no JS, so nothing can silently fail to
              swap. The reduced-motion <source> serves the still poster instead,
              honoring the design system's reduced-motion contract declaratively.
              The hero is above the fold, so it loads eagerly (no loading="lazy"). */}
          {app.demo.poster ? (
            <picture>
              <source srcset={app.demo.poster} media="(prefers-reduced-motion: reduce)" />
              <img class="demo-media" src={app.demo.src} alt={app.demo.alt} decoding="async" />
            </picture>
          ) : (
            <img class="demo-media" src={app.demo.src} alt={app.demo.alt} decoding="async" />
          )}
        </div>
      )}
    </section>

    <div class="specs">
      <div class="spec">
        <div class="lab">Platforms</div>
        <div class="val">
          {app.platforms.map((p, i) => {
            const label = PLATFORM_LABEL[p] ?? p;
            const url = platformUrl(p, app);
            return (
              <>
                {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                {url ? (
                  <a class="platform-link" href={url} rel="noopener">{label}</a>
                ) : (
                  <span>{label}</span>
                )}
              </>
            );
          })}
        </div>
      </div>
      <div class="spec">
        <div class="lab">Permissions</div>
        <div class="val">{app.permissions ?? 'None'}</div>
      </div>
      <div class="spec">
        <div class="lab">Network</div>
        <div class="val">{app.network ?? 'None'}</div>
      </div>
      <div class="spec">
        <div class="lab">License</div>
        <div class="val">{app.license ?? 'MIT'}</div>
      </div>
    </div>

    {app.body && (
      <section class="body">
        {app.body.map((para, i) => (
          <p class={i === 0 ? '' : 'dim'}>{para}</p>
        ))}

        {app.privacy && (
          <div class="privacy">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <div>
              <h3>{app.privacy.headline}</h3>
              <ul>
                {app.privacy.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        )}
      </section>
    )}

    {faq.length > 0 && (
      <section class="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Questions</h2>
        <dl>
          {faq.map((f) => (
            <div class="qa">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {(relatedPosts.length > 0 || relatedEssays.length > 0) && (
      <section class="reading" aria-labelledby="reading-heading">
        <h2 id="reading-heading">Further reading</h2>
        <ul>
          {relatedPosts.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <span class="reading-kind">{p.data.kind === 'launch' ? 'New app' : 'Alternative'}</span>
            </li>
          ))}
          {relatedEssays.map((w) => (
            <li>
              <a href={`/writing/${w.id}/`}>{w.data.title}</a>
              <span class="reading-kind">Writing</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <MoreApps currentSlug={app.slug} />

    <Footer />
  </div>

  {hasAnyStore && (
    <div id="install-modal" class="install-modal" hidden>
      <div class="install-backdrop" data-close></div>
      <div class="install-card" role="dialog" aria-modal="true" aria-label={`Get ${app.name}`}>
        <button class="install-close" type="button" data-close aria-label="Close">&times;</button>
        <h2>Get {app.name}</h2>
        <p class="install-sub">Free. No paywall, no ads, no tracking.</p>
        {hasMobileStore && qrSvg && (
          <div class="install-qr">
            <Fragment set:html={qrSvg} />
            <span>Scan with your phone’s camera to install</span>
          </div>
        )}
        <div class="install-stores">
          {iosHttps && (
            <a class="badge-link" data-store="ios" href={iosHttps} rel="noopener" aria-label="Download on the App Store">
              <img src="/assets/badges/apple-app-store.svg" alt="Download on the App Store" width="132" height="44" />
            </a>
          )}
          {androidHttps && (
            <a class="badge-link" data-store="android" href={androidHttps} rel="noopener" aria-label="Get it on Google Play">
              <img src="/assets/badges/google-play.svg" alt="Get it on Google Play" width="149" height="44" />
            </a>
          )}
          {webHttps && (
            <a class="btn primary" data-store="web" href={webHttps} rel="noopener">Add to your browser</a>
          )}
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var m = document.getElementById('install-modal');
        if (!m) return;
        function close() { m.hidden = true; document.documentElement.style.overflow = ''; }
        m.querySelectorAll('[data-close]').forEach(function (el) {
          el.addEventListener('click', close);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !m.hidden) close();
        });
      })();
    </script>
  )}
</Base>

<style>
  .container {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .lede {
    padding: 40px 0 12px;
  }
  .lede--demo {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 300px);
    gap: 52px;
    align-items: center;
  }
  .lede-copy {
    min-width: 0;
  }
  .idrow {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 22px;
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .lede h1 {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .value {
    font-size: 23px;
    line-height: 1.35;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--fg);
    margin: 0 0 20px;
  }
  .wedge {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 12px;
    padding: 0;
  }
  .wedge li {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--fg);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 5px 12px;
    background: var(--bg-elevated);
    white-space: nowrap;
  }
  .signature {
    font-size: 14px;
    color: var(--fg-muted);
    margin: 0 0 22px;
  }
  .beta-note {
    font-size: 14px;
    color: var(--marketing-terracotta);
    margin: 0 0 20px;
    max-width: 52ch;
  }
  .lede-demo {
    display: flex;
    justify-content: center;
  }
  .lede-demo picture {
    display: contents;
  }
  .demo-media {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    aspect-ratio: 600 / 1296;
    object-fit: contain;
    border: 1px solid var(--hairline);
    border-radius: 20px;
  }
  .beta-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--marketing-terracotta);
    border: 1px solid var(--marketing-terracotta);
    border-radius: 4px;
    padding: 3px 7px;
    line-height: 1;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 0 0;
    flex-wrap: wrap;
  }
  .badge-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .badge-link img {
    height: 44px;
    width: auto;
    display: block;
  }
  .badge-link:hover {
    opacity: 0.82;
  }
  .btn {
    height: 44px;
    padding: 0 18px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .btn.primary {
    background: var(--fg);
    color: var(--bg);
    border: 1px solid var(--fg);
  }
  .btn.primary:hover {
    background: var(--fg-muted);
  }
  .btn.secondary {
    background: var(--bg-elevated);
    color: var(--fg);
    border: 1px solid var(--hairline);
  }
  .btn.secondary:hover {
    border-color: var(--fg);
  }
  .specs {
    margin: 32px 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    overflow: hidden;
  }
  .spec {
    background: var(--bg-elevated);
    padding: 14px 18px;
  }
  .spec .lab {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .spec .val {
    font-size: 15px;
    font-weight: 500;
    color: var(--fg);
    margin-top: 4px;
  }
  .platform-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--marketing-terracotta);
    text-underline-offset: 3px;
    transition: color 120ms;
  }
  .platform-link:hover {
    color: var(--marketing-terracotta);
  }
  .body {
    padding: 24px 0;
  }
  .body p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 14px;
    max-width: 640px;
  }
  .body p.dim {
    color: var(--fg-muted);
  }
  .privacy {
    padding: 22px 24px;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--bg-elevated);
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 14px;
    margin: 16px 0 20px;
    max-width: 720px;
  }
  .privacy svg {
    color: var(--accent);
    margin-top: 2px;
  }
  .privacy h3 {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--fg);
  }
  .privacy ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }
  .privacy li {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .faq {
    padding: 8px 0 4px;
  }
  .faq h2,
  .reading h2 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0 0 16px;
  }
  .faq dl {
    margin: 0;
    border-top: 1px solid var(--hairline);
    max-width: 720px;
  }
  .faq .qa {
    padding: 18px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .faq dt {
    font-size: 16px;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 6px;
  }
  .faq dd {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0;
  }
  .reading {
    padding: 24px 0 4px;
  }
  .reading ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 720px;
  }
  .reading li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .reading li a {
    font-size: 15px;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--marketing-terracotta);
    text-underline-offset: 3px;
  }
  .reading li a:hover {
    color: var(--marketing-terracotta);
  }
  .reading-kind {
    font-family: var(--font-mono);
    font-size: 10px;
