---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime());

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base
  title="Blog · Josh Approved"
  description="New app announcements and honest, free alternatives to the paywalled utility apps they replace. No ads, no accounts, your data stays with you."
>
  <div class="container">
    <header class="head">
      <h1>Blog</h1>
      <p class="lede">
        New apps as they land, and honest comparisons with the paywalled tools
        they replace. Written in plain language, with a real attempt to be fair
        to the apps I'm building against.
      </p>
    </header>

    <ul class="list">
      {posts.map((post) => (
        <li class="item">
          <a href={`/blog/${post.id}/`}>
            <span class="kind">{post.data.kind === 'launch' ? 'New app' : 'Alternative to paid apps'} · {fmt(post.data.published)}</span>
            <h2>{post.data.title}</h2>
            <p>{post.data.dek}</p>
            <span class="more">Read</span>
          </a>
        </li>
      ))}
    </ul>

    <Footer />
  </div>
</Base>

<style>
  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .head {
    padding: 64px 0 8px;
  }
  .head h1 {
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 0 0 16px;
  }
  .head .lede {
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0;
  }
  .list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .item {
    border-bottom: 1px solid var(--hairline);
  }
  .item a {
    display: block;
    padding: 28px 0;
    text-decoration: none;
    color: inherit;
  }
  .item .kind {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
  }
  .item h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 8px 0 8px;
  }
  .item p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-muted);
    margin: 0 0 12px;
  }
  .item .more {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--marketing-terracotta);
  }
  .item a:hover h2 {
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 3px;
  }
  @media (max-width: 540px) {
    .container { padding: 0 20px; }
    .head h1 { font-size: 36px; }
    .head { padding: 40px 0 4px; }
  }
</style>
