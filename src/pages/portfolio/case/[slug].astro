---
import Base from '../../../layouts/Base.astro';
import Footer from '../../../components/Footer.astro';
import PortfolioBoot from '../../../components/PortfolioBoot.astro';
import PortfolioGate from '../../../components/PortfolioGate.astro';
import Blocks from '../../../components/case/Blocks.astro';
import Metrics from '../../../components/case/Metrics.astro';
import { CASES } from '../../../data/portfolio';

export function getStaticPaths() {
  return CASES.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const index = CASES.findIndex((c) => c.slug === study.slug);
const next = CASES[(index + 1) % CASES.length];
---
<Base
  title={`${study.title} · Portfolio · Josh Approved`}
  description={study.dek}
  ogTitle={study.title}
  crumb={study.title}
  crumbParent={{ href: '/portfolio/', label: 'Portfolio' }}
  noindex
>
  <PortfolioBoot />
  <div class="container">
    <header class="masthead">
      <span class="kicker">{study.year} · {study.discipline}</span>
      <h1>{study.title}</h1>
      <p class="dek">{study.dek}</p>
    </header>

    {/* Locked: the title and the one-line summary are already public on the
        index, so the page is not a dead end. Everything below is not. */}
    <div class="locked-only">
      <PortfolioGate variant="panel" heading="This case study is locked" />
    </div>

    <article class="unlocked-only">
      <dl class="facts">
        {study.facts.map((f) => (
          <div class="factrow">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>

      <section class="outcomes" aria-label="Outcome summary">
        <Metrics items={study.outcomes} variant="strip" />
      </section>

      <nav class="secindex" aria-label="Sections">
        {study.sections.map((s) => (
          <a href={`#${s.id}`}>
            <span class="ix-letter">{s.letter}</span>
            <span class="ix-title">{s.title}</span>
          </a>
        ))}
      </nav>

      {study.sections.map((s) => (
        <section class="section" id={s.id}>
          <header class="sechead">
            <span class="marker" aria-hidden="true">{s.letter}</span>
            <div class="sectext">
              <h2>{s.title}</h2>
              <p class="prompt">{s.prompt}</p>
            </div>
          </header>
          <Blocks blocks={s.blocks} />
        </section>
      ))}

      <nav class="nextcase" aria-label="Next case study">
        <span class="nextlabel">Next case study</span>
        <a href={`/portfolio/case/${next.slug}/`}>{next.title}</a>
      </nav>
    </article>

    <Footer />
  </div>
</Base>

<style>
  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Which half of the page shows is set by the boot script before the body
     parses, so a locked visitor never sees the article flash past. With
     JavaScript off, the article stays hidden and the gate stays up. */
  .unlocked-only {
    display: none;
  }
  :global(html[data-portfolio='unlocked']) .unlocked-only {
    display: block;
  }
  :global(html[data-portfolio='unlocked']) .locked-only {
    display: none;
  }

  .masthead {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 0 0;
  }
  .kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-subtle);
    margin-bottom: 14px;
  }
  .masthead h1 {
    font-size: 46px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 600;
    margin: 0 0 16px;
  }
  .masthead .dek {
    font-size: 19px;
    line-height: 1.55;
    color: var(--fg-muted);
    margin: 0;
  }

  /* The spec table. Same five rows on every case study, so two projects can be
     compared at a glance. */
  .facts {
    max-width: 720px;
    margin: 36px auto 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }
  .factrow {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    padding-top: 3px;
  }
  .facts dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg);
  }

  .outcomes {
    max-width: 720px;
    margin: 32px auto 0;
  }

  .secindex {
    max-width: 720px;
    margin: 40px auto 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .secindex a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px 8px 8px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    text-decoration: none;
    color: var(--fg-muted);
    transition: border-color 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .secindex a:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .ix-letter {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background: var(--bg-subtle);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg);
  }
  .ix-title {
    font-size: 14px;
  }

  .section {
    margin-top: 64px;
    scroll-margin-top: 24px;
  }
  .sechead {
    max-width: 720px;
    margin: 0 auto 28px;
    padding-top: 24px;
    border-top: 2px solid var(--fg);
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .marker {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--fg);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sectext h2 {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
    line-height: 1.2;
  }
  .prompt {
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-muted);
    margin: 0;
  }

  .nextcase {
    max-width: 720px;
    margin: 72px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .nextlabel {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }
  .nextcase a {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-decoration: none;
  }
  .nextcase a:hover {
    text-decoration: underline;
    text-decoration-color: var(--marketing-terracotta);
    text-underline-offset: 4px;
  }

  @media (max-width: 540px) {
    .container {
      padding: 0 20px;
    }
    .masthead h1 {
      font-size: 33px;
    }
    .masthead .dek {
      font-size: 17px;
    }
    .factrow {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .section {
      margin-top: 48px;
    }
    .sectext h2 {
      font-size: 22px;
    }
  }
</style>
