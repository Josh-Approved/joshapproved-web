---
import type { AppRecord } from '../data/apps.ts';

type Props = {
  app: AppRecord;
  size?: 'sm' | 'lg';
};

const { app, size = 'sm' } = Astro.props;
const cornerCheck = size === 'lg' ? 14 : 9;
const hasImage = Boolean(app.icon);
---
<div class={`frame frame--${size}${hasImage ? ' frame--image' : ''}`}>
  {hasImage ? (
    <img src={app.icon} alt="" class="icon-img" />
  ) : app.from && app.to ? (
    <div class="ig">
      {app.from}<em>{app.to}</em>
    </div>
  ) : (
    <div class="glyph">{app.glyph ?? '·'}</div>
  )}
  <span class="corner">
    <svg width={cornerCheck} height={cornerCheck} viewBox="0 0 24 24" fill="none" stroke="#FAFAF7" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="20 6 9 17 4 12" />
    </svg>
  </span>
</div>

<style>
  .frame {
    width: var(--icon-size);
    height: var(--icon-size);
    border-radius: var(--icon-radius);
    background: var(--paper);
    border: 1px solid var(--hairline);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .frame--lg {
    --icon-size: 96px;
    --icon-radius: 22px;
    --corner-size: 22px;
    --corner-offset: 8px;
    --corner-radius: 5px;
    --glyph-size: 36px;
    --ig-size: 22px;
    --ig-em-size: 16px;
  }
  .frame--sm {
    --icon-size: 56px;
    --icon-radius: 14px;
    --corner-size: 14px;
    --corner-offset: 5px;
    --corner-radius: 4px;
    --glyph-size: 22px;
    --ig-size: 14px;
    --ig-em-size: 9px;
  }
  .frame--image {
    background: transparent;
    border: none;
  }
  .icon-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .ig {
    font-size: var(--ig-size);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    line-height: 1;
    text-align: center;
  }
  .ig em {
    font-size: var(--ig-em-size);
    font-style: normal;
    color: var(--fg-subtle);
    display: block;
    font-weight: 500;
    margin-top: 2px;
  }
  .glyph {
    font-size: var(--glyph-size);
    font-weight: 500;
    color: var(--fg);
    line-height: 1;
    text-align: center;
  }
  .corner {
    width: var(--corner-size);
    height: var(--corner-size);
    right: var(--corner-offset);
    bottom: var(--corner-offset);
    border-radius: var(--corner-radius);
    position: absolute;
    background: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 2px var(--paper);
  }
</style>
