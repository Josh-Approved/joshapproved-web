---
// Internal cross-link strip shown at the foot of every app page. Every other
// app links to this same component, so the whole catalog is one connected graph
// — good for the visitor (discover the sibling apps) and good for SEO (internal
// links spread crawl + link equity across every app detail page, and no app
// page is an orphan reachable only from /apps).
import type { AppRecord } from '../data/apps.ts';
import { APPS, PLATFORM_LABEL } from '../data/apps.ts';
import AppIcon from './AppIcon.astro';

type Props = { currentSlug: string };
const { currentSlug } = Astro.props;

// Live apps lead, planned trail; drop the app we're already on.
const STATUS_RANK: Record<AppRecord['status'], number> = {
  shipped: 0,
  'in-progress': 1,
  planned: 2,
};
const others = APPS.filter((a) => a.slug !== currentSlug).sort(
  (a, b) => STATUS_RANK[a.status] - STATUS_RANK[b.status],
);
---
{others.length > 0 && (
  <section class="more" aria-labelledby="more-apps-heading">
    <div class="more-head">
      <h2 id="more-apps-heading">More from Josh Approved</h2>
      <a class="more-all" href="/apps/">All apps →</a>
    </div>

    <ul class="rail">
      {others.map((app) => (
        <li class="tile">
          <a href={`/apps/${app.slug}/`}>
            <div class="tile-head">
              <AppIcon app={app} size="sm" />
              <div class="tile-title">
                <span class="name">{app.name}</span>
                {app.status === 'in-progress' && <span class="beta">BETA</span>}
              </div>
            </div>
            <p class="blurb">{app.value ?? app.tagline}</p>
            <span class="plats">
              {app.platforms.map((p) => PLATFORM_LABEL[p] ?? p).join(' · ')}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .more {
    margin: 8px 0 8px;
    padding: 28px 0 4px;
    border-top: 1px solid var(--hairline);
  }
  .more-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 18px;
  }
  .more-head h2 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }
  .more-all {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .more-all:hover {
    color: var(--marketing-terracotta);
  }
  /* Horizontal scroller — contains its own overflow so the page body never
     scrolls sideways. Snap for a tidy swipe; scrollbar left visible on touch. */
  .rail {
    list-style: none;
    margin: 0;
    /* Bottom padding clears the horizontal scrollbar so it sits below the tiles
       rather than over them. Must be >= the scrollbar height set below. */
    padding: 0 0 14px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(210px, 1fr);
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    /* Scroll horizontally only. Setting overflow-x alone makes the browser
       compute overflow-y to `auto`, which produced a stray vertical scrollbar
       (the horizontal scrollbar ate a few px of height). Pin y to hidden, give
       the horizontal scrollbar a known thin height, and pad for it above. */
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .rail::-webkit-scrollbar {
    height: 8px;
  }
  .rail::-webkit-scrollbar-thumb {
    background: var(--hairline-strong, var(--fg-subtle));
    border-radius: 999px;
  }
  .rail::-webkit-scrollbar-track {
    background: transparent;
  }
  .tile {
    background: var(--bg);
    scroll-snap-align: start;
    transition: background 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .tile:hover {
    background: var(--bg-elevated);
  }
  .tile > a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 18px 16px;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .tile-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tile-title {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .tile .name {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .tile .beta {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--marketing-terracotta);
    border: 1px solid var(--marketing-terracotta);
    border-radius: 4px;
    padding: 2px 5px;
    line-height: 1;
  }
  .tile .blurb {
    font-size: 13px;
    line-height: 1.45;
    color: var(--fg-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tile .plats {
    /* Not pinned to the bottom of the tile: the horizontal scrollbar clips the
       last few px of the tile, so keeping this line with the content above keeps
       it fully visible. Equal-height tiles just get empty space at the foot. */
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-subtle);
  }
  /* The sm AppIcon in a compact tile — trim it a touch. */
  .tile :global(.frame--sm) {
    --icon-size: 40px;
    --icon-radius: 10px;
    --corner-size: 11px;
    --corner-offset: 4px;
    --corner-radius: 3px;
    --glyph-size: 16px;
    --ig-size: 11px;
    --ig-em-size: 7px;
  }
  @media (max-width: 640px) {
    .rail {
      grid-auto-columns: minmax(180px, 78%);
    }
  }
</style>
