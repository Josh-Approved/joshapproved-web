---
const year = new Date().getFullYear();
---
<footer>
  <span>© {year} Josh Approved · MIT</span>
  <span class="stamp">
    <span class="check">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#FAFAF7" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </span>
    <span class="col">
      <span class="kicker">APPROVED BY</span>
      <span class="name">josh</span>
    </span>
  </span>
</footer>

<style>
  footer {
    padding: 32px 0 48px;
    margin-top: 32px;
    border-top: 1px solid var(--hairline);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--fg-muted);
    gap: 16px;
    flex-wrap: wrap;
  }
  .stamp {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px 8px 10px;
    border: 1px solid var(--ink-1000);
    border-radius: 12px;
  }
  .check {
    width: 22px;
    height: 22px;
    background: var(--accent);
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .col {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 3px;
  }
  .kicker {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--fg-muted);
    text-transform: uppercase;
  }
  .name {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
</style>
