---
import { PASSPHRASE_SHA256 } from '../data/portfolio';

type Props = {
  /** 'bar' sits under the portfolio index heading. 'panel' is the full stop
   *  on a locked case study page. */
  variant?: 'bar' | 'panel';
  heading?: string;
  /** Optional. Left unset by default: the lock, the heading and the field say
   *  enough on their own. */
  body?: string;
};

const { variant = 'bar', heading = 'These case studies are locked', body } = Astro.props;
---
{/* Once unlocked the whole thing disappears and the case studies move up.
    There is no "unlocked" confirmation state: the case studies opening is the
    confirmation. */}
<section class:list={['gate', `gate--${variant}`]} data-gate aria-labelledby="gate-heading">
    <span class="icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
    </span>
    <h2 id="gate-heading">{heading}</h2>
    {body && <p class="body">{body}</p>}

    <form class="form" data-gate-form novalidate>
      <label class="field">
        <span class="fieldlabel">Password</span>
        <input
          type="password"
          name="portfolio-password"
          data-gate-input
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          aria-describedby="gate-error"
        />
      </label>
      <button type="submit">Unlock</button>
    </form>

    <p class="error" id="gate-error" data-gate-error role="status" hidden></p>
</section>

<script is:inline define:vars={{ hash: PASSPHRASE_SHA256 }}>
  (function () {
    var STORE = 'ja-portfolio';

    function canonical(value) {
      // Phones autocorrect a straight quote into a curly one. Accept both.
      return String(value)
        .replace(/[‘’ʼ´]/g, "'")
        .trim()
        .toLowerCase();
    }

    async function digest(value) {
      var bytes = new TextEncoder().encode(value);
      var buf = await crypto.subtle.digest('SHA-256', bytes);
      return Array.from(new Uint8Array(buf))
        .map(function (b) {
          return b.toString(16).padStart(2, '0');
        })
        .join('');
    }

    document.querySelectorAll('[data-gate]').forEach(function (gate) {
      var form = gate.querySelector('[data-gate-form]');
      var input = gate.querySelector('[data-gate-input]');
      var error = gate.querySelector('[data-gate-error]');

      function fail(message) {
        error.textContent = message;
        error.hidden = false;
        gate.setAttribute('data-shake', '');
        setTimeout(function () {
          gate.removeAttribute('data-shake');
        }, 400);
        input.select();
      }

      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        error.hidden = true;

        if (!window.crypto || !crypto.subtle) {
          fail('This browser cannot check the password here. Try a different browser, or email me.');
          return;
        }

        var value = canonical(input.value);
        if (!value) {
          fail('Enter the password first.');
          return;
        }

        var hex = await digest(value);
        if (hex !== hash) {
          fail('That password does not match. Try again, or email me and I will send it over.');
          return;
        }

        try {
          window.localStorage.setItem(STORE, hash);
        } catch (e) {
          /* Storage blocked: unlocked for this page view only. */
        }
        input.value = '';
        document.documentElement.setAttribute('data-portfolio', 'unlocked');
      });
    });
  })();
</script>

<style>
  .gate {
    border: 1px solid var(--hairline);
    border-radius: 16px;
    background: var(--bg-elevated);
  }
  .gate--bar {
    padding: 24px;
    margin: 32px 0 0;
  }
  .gate--panel {
    padding: 40px;
    margin: 48px 0;
    text-align: center;
  }

  /* Unlocked, the gate is gone rather than replaced by a confirmation, so the
     case studies sit as high on the page as they can. The boot script sets the
     attribute before the body parses, so an unlocked visitor never sees it. */
  :global(html[data-portfolio='unlocked']) .gate {
    display: none;
  }

  .icon {
    display: inline-flex;
    color: var(--fg-muted);
    margin-bottom: 12px;
  }
  .gate h2 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--fg-muted);
    margin: 0;
    max-width: 56ch;
  }
  .gate--panel .body {
    margin-left: auto;
    margin-right: auto;
  }

  .form {
    margin-top: 18px;
    display: flex;
    gap: 10px;
    align-items: flex-end;
    flex-wrap: wrap;
  }
  .gate--panel .form {
    justify-content: center;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }
  .fieldlabel {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }
  .field input {
    box-sizing: border-box;
    font-family: var(--font-system);
    font-size: 16px;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--hairline-strong);
    border-radius: 10px;
    padding: 11px 14px;
    width: 260px;
    max-width: 100%;
  }
  .field input:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .form button {
    font-family: var(--font-system);
    font-size: 15px;
    font-weight: 500;
    color: var(--fg-on-ink);
    background: var(--fg);
    border: 1px solid var(--fg);
    border-radius: 10px;
    padding: 12px 20px;
    cursor: pointer;
    transition: opacity var(--duration-fast, 150ms) cubic-bezier(0.2, 0, 0, 1);
  }
  .form button:hover {
    opacity: 0.85;
  }

  .error {
    font-size: 14px;
    line-height: 1.55;
    color: var(--danger);
    margin: 12px 0 0;
  }
  .gate[data-shake] {
    animation: shake 320ms cubic-bezier(0.2, 0, 0, 1);
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gate[data-shake] {
      animation: none;
    }
  }

  @media (max-width: 540px) {
    .gate--panel {
      padding: 28px 20px;
    }
    .form {
      align-items: stretch;
      flex-direction: column;
    }
    .field input {
      width: 100%;
    }
  }
</style>
