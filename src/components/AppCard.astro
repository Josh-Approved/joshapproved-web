---
import type { AppRecord } from '../data/apps.ts';
import { PLATFORM_LABEL, platformUrl } from '../data/apps.ts';
import AppIcon from './AppIcon.astro';

type Props = { app: AppRecord };
const { app } = Astro.props;
---
<article class="card">
  <a class="card-main" href={`/apps/${app.slug}/`}>
    <AppIcon app={app} size="sm" />
    <div>
      <h3>{app.name}</h3>
    </div>
    <p>{app.description}</p>
  </a>
  <div class="platforms">
    {app.platforms.map((p, i) => {
      const label = PLATFORM_LABEL[p] ?? p;
      const url = platformUrl(p, app);
      return (
        <>
          {i > 0 && <span class="dot" aria-hidden="true">·</span>}
          {url ? (
            <a class="platform-link" href={url} rel="noopener">{label}</a>
          ) : (
            <span class="platform-link platform-link--inert">{label}</span>
          )}
        </>
      );
    })}
  </div>
</article>

<style>
  .card {
    background: var(--paper);
    padding: 22px 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .card:hover {
    background: var(--pure-white);
  }
  .card-main {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: inherit;
  }
  .card h3 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }
  .card p {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.5;
    margin: 0;
  }
  .platforms {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .platforms .dot {
    color: var(--fg-subtle);
  }
  .platform-link {
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 120ms, border-color 120ms;
  }
  a.platform-link:hover {
    color: var(--fg);
    border-bottom-color: var(--marketing-terracotta);
  }
  .platform-link--inert {
    color: var(--fg-muted);
    cursor: default;
  }
</style>
