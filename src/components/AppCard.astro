---
import type { AppRecord } from '../data/apps.ts';
import { PLATFORM_LABEL, platformUrl } from '../data/apps.ts';
import AppIcon from './AppIcon.astro';

type Props = { app: AppRecord };
const { app } = Astro.props;
---
<article class="card">
  <a class="card-main" href={`/apps/${app.slug}/`}>
    {app.demo && (
      <div class="card-demo">
        <img
          class="demo-media"
          src={app.demo.poster ?? app.demo.src}
          data-gif={app.demo.poster ? app.demo.src : undefined}
          alt={app.demo.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
    <div class="card-head">
      <AppIcon app={app} size="sm" />
      <div class="title-row">
        <h3>{app.name}</h3>
        {app.status === 'in-progress' && <span class="beta-tag">BETA</span>}
      </div>
    </div>
    <p>{app.value ?? app.description}</p>
    <p class="wedge">No paywall · No ads · No tracking · No accounts</p>
  </a>
  <div class="platforms">
    {app.platforms.map((p, i) => {
      const label = PLATFORM_LABEL[p] ?? p;
      const url = platformUrl(p, app);
      return (
        <>
          {i > 0 && <span class="dot" aria-hidden="true">·</span>}
          {url ? (
            <a class="platform-link" href={url} rel="noopener">{label}</a>
          ) : (
            <span class="platform-link platform-link--inert">{label}</span>
          )}
        </>
      );
    })}
  </div>
</article>

<style>
  .card {
    background: var(--bg);
    padding: 22px 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .card:hover {
    background: var(--bg-elevated);
  }
  .card-main {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .card-demo {
    display: flex;
    justify-content: center;
    padding: 2px 0 4px;
  }
  .card-demo .demo-media {
    display: block;
    width: 132px;
    height: auto;
    aspect-ratio: 600 / 1296;
    object-fit: contain;
    border: 1px solid var(--hairline);
    border-radius: 16px;
  }
  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .card h3 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .card .wedge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    color: var(--fg-subtle);
    line-height: 1.5;
    margin: 2px 0 0;
  }
  .beta-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--marketing-terracotta);
    border: 1px solid var(--marketing-terracotta);
    border-radius: 4px;
    padding: 2px 6px;
    line-height: 1;
  }
  .card p {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.5;
    margin: 0;
  }
  .platforms {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .platforms .dot {
    color: var(--fg-subtle);
  }
  .platform-link {
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 120ms, border-color 120ms;
  }
  a.platform-link:hover {
    color: var(--fg);
    border-bottom-color: var(--marketing-terracotta);
  }
  .platform-link--inert {
    color: var(--fg-muted);
    cursor: default;
  }
</style>
