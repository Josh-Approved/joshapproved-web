---
type Props = { label: string; body: string };
const { label, body } = Astro.props;
---
<aside class="callout">
  <span class="label">{label}</span>
  <p>{body}</p>
</aside>

<style>
  /* A constraint, a decision, or an honest admission. Boxed so it reads as a
     stated position rather than more body copy. */
  .callout {
    /* Border and padding inside the reading column, so the box lines up with
       the body copy rather than bulging past it. */
    box-sizing: border-box;
    max-width: 720px;
    margin: 32px auto;
    padding: 18px 20px;
    background: var(--bg-elevated);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--marketing-terracotta);
    border-radius: 0 12px 12px 0;
  }
  .label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    margin-bottom: 8px;
  }
  .callout p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--fg);
    margin: 0;
  }
</style>
