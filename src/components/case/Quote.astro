---
type Props = { text: string; source: string };
const { text, source } = Astro.props;
---
<blockquote class="quote">
  <p>{text}</p>
  <cite>{source}</cite>
</blockquote>

<style>
  /* A verbatim line from research. Attribution is required: an unattributed
     quote in a case study is decoration. */
  .quote {
    /* Padding and the rule are inside the reading column, so the text edge
       still lines up with the body copy above it. */
    box-sizing: border-box;
    max-width: 720px;
    margin: 32px auto;
    padding: 0 0 0 22px;
    border-left: 3px solid var(--marketing-terracotta);
  }
  .quote p {
    font-size: 19px;
    line-height: 1.6;
    color: var(--fg);
    margin: 0 0 10px;
  }
  .quote cite {
    font-family: var(--font-mono);
    font-size: 11px;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }
  @media (max-width: 540px) {
    .quote p {
      font-size: 17px;
    }
  }
</style>
