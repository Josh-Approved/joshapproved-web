---
type Props = { columns: string[]; rows: string[][]; caption?: string };
const { columns, rows, caption } = Astro.props;
---
<figure class="tablewrap">
  <div class="scroll">
    <table>
      <thead>
        <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            {r.map((cell, i) =>
              i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Numbers that are easier read than charted: targets, comparisons, counts. */
  .tablewrap {
    max-width: 720px;
    margin: 32px auto;
  }
  .scroll {
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: 12px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  th,
  td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    background: var(--bg-subtle);
  }
  tbody th {
    font-weight: 500;
    color: var(--fg);
    white-space: normal;
  }
  tbody td {
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }
  figcaption {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
</style>
