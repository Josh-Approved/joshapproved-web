---
import type { Figure } from '../../data/portfolio';

type Props = Figure & {
  /** Set when the figure is a cell inside a FigureGrid, so it does not set its
   *  own width. */
  inGrid?: boolean;
};

const {
  tag,
  src,
  alt,
  caption,
  width = 'column',
  ratio = '16 / 10',
  inGrid = false,
} = Astro.props;
const widthClass = inGrid ? 'fig-cell' : `fig-${width}`;
---
<figure class:list={['fig', widthClass]}>
  {src ? (
    <div class="frame">
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="frame pending" style={`aspect-ratio: ${ratio};`}>
      <span class="pending-label">Image to come</span>
    </div>
  )}
  <figcaption>
    <span class="tag">{tag}</span>
    <span class="cap">{caption}</span>
  </figcaption>
</figure>

<style>
  /* One figure treatment for every image in every case study: a hairline frame,
     a tag saying what kind of evidence it is, and a caption. Nothing else. */
  .fig {
    margin: 36px 0;
  }
  .fig-narrow {
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
  }
  .fig-column {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .fig-wide {
    max-width: 1080px;
    margin-left: auto;
    margin-right: auto;
  }
  .fig-cell {
    margin: 0;
  }
  .frame {
    border: 1px solid var(--hairline);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-elevated);
    line-height: 0;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  /* An image slot waiting on the real photo. Dashed and labelled so it can
     never be mistaken for finished work, but the right shape so the page
     reads at its real weight. */
  .pending {
    border: 1px dashed var(--hairline-strong);
    background: var(--bg-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pending-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-subtle);
    line-height: 1;
  }
  figcaption {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 12px;
  }
  .tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    border: 1px solid var(--hairline-strong);
    border-radius: 4px;
    padding: 3px 7px;
    line-height: 1;
  }
  .cap {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  @media (max-width: 540px) {
    .fig {
      margin: 28px 0;
    }
    figcaption {
      flex-direction: column;
      gap: 8px;
    }
    .tag {
      align-self: flex-start;
    }
  }
</style>
