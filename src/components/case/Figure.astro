---
import type { Figure } from '../../data/portfolio';

type Props = Figure & {
  /** Set when the figure is a cell inside a FigureGrid, so it does not set its
   *  own width. */
  inGrid?: boolean;
};

const { tag, src, alt, caption, width = 'column', inGrid = false } = Astro.props;
const widthClass = inGrid ? 'fig-cell' : width === 'wide' ? 'fig-wide' : 'fig-col';
---
<figure class:list={['fig', widthClass]}>
  <div class="frame">
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
  <figcaption>
    <span class="tag">{tag}</span>
    <span class="cap">{caption}</span>
  </figcaption>
</figure>

<style>
  /* One figure treatment for every image in every case study: a hairline frame,
     a tag saying what kind of evidence it is, and a caption. Nothing else. */
  .fig {
    margin: 36px 0;
  }
  .fig-col {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .fig-wide {
    max-width: 1080px;
    margin-left: auto;
    margin-right: auto;
  }
  .fig-cell {
    margin: 0;
  }
  .frame {
    border: 1px solid var(--hairline);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-elevated);
    line-height: 0;
  }
  .frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 12px;
  }
  .tag {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    border: 1px solid var(--hairline-strong);
    border-radius: 4px;
    padding: 3px 7px;
    line-height: 1;
  }
  .cap {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  @media (max-width: 540px) {
    .fig {
      margin: 28px 0;
    }
    figcaption {
      flex-direction: column;
      gap: 8px;
    }
    .tag {
      align-self: flex-start;
    }
  }
</style>
