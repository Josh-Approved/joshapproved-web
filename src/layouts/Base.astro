---
import Nav from '../components/Nav.astro';

type Props = {
  title: string;
  description?: string;
  canonical?: string;
  /** Share-card title (og/twitter). Defaults to `title`; pass a shorter,
   *  brand-free string for link previews where the domain already shows. */
  ogTitle?: string;
  /** Path to a share-card image (1200×630). Resolved to an absolute URL. */
  image?: string;
  /** Breadcrumb leaf label. Set on detail pages (app / post) only; a row
   *  renders below the header. Section index pages leave it unset. */
  crumb?: string;
  crumbParent?: { href: string; label: string };
};

const { title, description, canonical, ogTitle, image, crumb, crumbParent } = Astro.props;
const fullCanonical = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const fullDescription =
  description ??
  'Privacy-first, open-source replacements for paywalled utility apps.';
const shareTitle = ogTitle ?? title;
const fullImage = image ? new URL(image, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={fullDescription} />
    <link rel="canonical" href={fullCanonical} />

    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:site_name" content="Josh Approved" />
    {fullImage && (
      <>
        <meta property="og:image" content={fullImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <meta name="twitter:card" content={fullImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={fullDescription} />
    {fullImage && <meta name="twitter:image" content={fullImage} />}

    <link rel="icon" type="image/svg+xml" href="/assets/wordmark.svg" />

    <link rel="preload" href="/fonts/IBMPlexSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexSans-SemiBold.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="stylesheet" href="/styles/tokens.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="page-shell">
        <Nav crumb={crumb} crumbParent={crumbParent} />
      </div>
    </header>
    <slot />
  </body>
</html>

<style>
  /* One header for the whole site, rendered here so it is identical and in the
     same place on every page. It sits at a fixed width independent of each
     page's content width (which varies: 720 for prose, 1080 for the grids), so
     the logo and links never shift between pages. */
  .page-shell {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
  }
  @media (max-width: 640px) {
    .page-shell {
      padding: 0 20px;
    }
  }
</style>
